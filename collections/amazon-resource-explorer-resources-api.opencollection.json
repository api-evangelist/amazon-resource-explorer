{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon Resource Explorer Index Resources API",
    "version": "2022-07-28"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Resources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Supported Resource Types",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://resource-explorer-2.{region}.amazonaws.com/ListSupportedResourceTypes"
          },
          "docs": "Lists the resource types supported by Resource Explorer."
        }
      ]
    }
  ],
  "bundled": true
}